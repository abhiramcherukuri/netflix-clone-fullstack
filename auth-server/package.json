{
  "name": "auth-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#config": "./src/config/index.ts",
    "#middleware": "./src/middleware/index.ts",
    "#utils": "./src/utils/index.ts",
    "#oauth": "./src/oauth/index.ts",
    "#modules/*": "./src/modules/*/index.ts"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec node --env-file=../.env --strip-types src/server.ts",
    "start": "node --env-file=../.env --strip-types src/server.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.0.1",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "mongoose": "^9.0.0",
    "oidc-provider": "^9.12.0",
    "redis": "^6.0.0",
    "resend": "^6.25.0",
    "winston": "^3.17.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/oidc-provider": "^9.11.1",
    "nodemon": "^3.1.9",
    "typescript": "~6.0.3"
  }
}
