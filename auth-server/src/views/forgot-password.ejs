<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Forgot Password' }) %>
  </head>
  <body>
    <div class="auth-backdrop"></div>
    <%- include('partials/header') %>

    <main class="auth-container">
      <div class="auth-card">
        <h1 class="auth-title">Forgot Password</h1>

        <p style="color: var(--color-text-muted); font-size: var(--font-size-sm); margin-bottom: var(--space-6); line-height: 1.5;">
          Enter your email address and we will send you a link to reset your password.
        </p>

        <% if (locals.error) { %>
          <div class="alert-error"><%= error %></div>
        <% } %>

        <% if (locals.message) { %>
          <div class="alert-success"><%= message %></div>
        <% } %>

        <form action="/auth/forgot-password" method="POST">
          <div class="form-group">
            <input
              type="email"
              id="email"
              name="email"
              class="form-input"
              placeholder="name@example.com"
              value="<%= locals.email || '' %>"
              required
              autocomplete="email"
            />
          </div>

          <button type="submit" class="btn-primary">Send Reset Link</button>

          <div class="auth-links" style="margin-top: var(--space-6); text-align: center;">
            <% if (locals.uid) { %>
              <a href="/interaction/<%= uid %>">Back to Sign In</a>
            <% } else { %>
              <a href="/">Back to Sign In</a>
            <% } %>
          </div>
        </form>
      </div>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>