<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %> - <%= app.APP_TITLE_SUFFIX %></title>

<!-- Shared Design Tokens & Inter Font -->
<link rel="stylesheet" href="/shared/styles/design-tokens.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: var(--color-background);
    font-family: var(--font-family);
    color: var(--color-text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow-x: hidden;
  }

  /* Netflix Movie Poster Background Backdrop */
  .auth-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.6) 0%,
        rgba(0, 0, 0, 0.85) 100%
      ),
      radial-gradient(circle at 50% 50%, rgba(20, 20, 20, 0.4) 0%, var(--color-background) 100%);
    background-size: cover;
    background-position: center;
  }

  .auth-header {
    padding: var(--space-6) var(--space-12);
  }

  .brand-logo {
    color: var(--color-primary);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-block;
  }

  .auth-container {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--space-6);
  }

  .auth-card {
    background: rgba(0, 0, 0, 0.75);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-12);
    width: 100%;
    max-width: 28rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
  }

  .auth-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-6);
    color: var(--color-text);
  }

  .form-group {
    position: relative;
    margin-bottom: var(--space-4);
  }

  .form-input {
    width: 100%;
    height: var(--input-height);
    background: var(--input-bg);
    border: 1px solid transparent;
    border-radius: var(--input-radius);
    color: var(--color-text);
    padding: var(--space-4);
    font-size: var(--font-size-base);
    outline: none;
    transition: var(--transition-fast);
  }

  .form-input:focus {
    border-color: var(--color-text);
    background: #454545;
  }

  .btn-primary {
    width: 100%;
    height: var(--input-height);
    background-color: var(--color-primary);
    color: var(--color-text);
    border: none;
    border-radius: var(--radius-sm);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);
    cursor: pointer;
    margin-top: var(--space-3);
    transition: var(--transition-fast);
  }

  .btn-primary:hover {
    background-color: var(--color-primary-hover);
  }

  .alert-error {
    background-color: rgba(232, 124, 3, 0.2);
    border-left: 4px solid var(--color-error);
    color: var(--color-text);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-4);
  }

  .alert-success {
    background-color: rgba(70, 211, 105, 0.2);
    border-left: 4px solid var(--color-success);
    color: var(--color-text);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-4);
  }

  .auth-links {
    margin-top: var(--space-6);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .auth-links a {
    color: var(--color-text);
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
  }

  .auth-links a:hover {
    text-decoration: underline;
  }

  .auth-footer {
    padding: var(--space-8) var(--space-12);
    background: rgba(0, 0, 0, 0.75);
    border-top: 1px solid var(--color-border);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (max-width: 600px) {
    .auth-header {
      padding: var(--space-4) var(--space-6);
    }
    .auth-card {
      padding: var(--space-8) var(--space-6);
      background: transparent;
      border: none;
      box-shadow: none;
    }
    .auth-footer {
      padding: var(--space-6) var(--space-4);
    }
  }
</style>