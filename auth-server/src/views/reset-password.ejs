<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Reset Password' }) %>
  </head>
  <body>
    <div class="auth-backdrop"></div>
    <%- include('partials/header') %>

    <main class="auth-container">
      <div class="auth-card">
        <h1 class="auth-title">Reset Password</h1>

        <p style="color: var(--color-text-muted); font-size: var(--font-size-sm); margin-bottom: var(--space-6); line-height: 1.5;">
          Enter a new secure password for your account.
        </p>

        <% if (locals.error) { %>
          <div class="alert-error"><%= error %></div>
        <% } %>

        <% if (locals.message) { %>
          <div class="alert-success"><%= message %></div>
        <% } %>

        <form action="/auth/reset-password/<%= token %>" method="POST">
          <div class="form-group">
            <input
              type="password"
              id="password"
              name="password"
              class="form-input"
              placeholder="New password (min 8 characters)"
              required
              autocomplete="new-password"
            />
          </div>

          <div class="form-group">
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              class="form-input"
              placeholder="Confirm new password"
              required
              autocomplete="new-password"
            />
          </div>

          <button type="submit" class="btn-primary">Save New Password</button>

          <div class="auth-links" style="margin-top: var(--space-6); text-align: center;">
            <a href="/">Back to Sign In</a>
          </div>
        </form>
      </div>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>